{
  "name": "sternenfront",
  "version": "1.0.0",
  "private": true,
  "description": "Sternenfront – ein mobiles 3D-Weltraumkampfspiel mit Story-Kampagne",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
